# ============================================================
# Codebase Context Extraction Pipeline — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# LLM provider to use for distillation and summarization.
# Options: openai | anthropic
LLM_PROVIDER=openai

# OpenAI API key — required in ALL configurations (always used for embeddings).
OPENAI_API_KEY=sk-...

# Anthropic API key — only required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase project URL and service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Absolute or relative path to the repository you want to analyze.
TARGET_REPO_PATH=/path/to/your/repo

# Dimensions of the OpenAI embedding vectors.
# 1536 = text-embedding-3-small / text-embedding-ada-002 (default)
# 3072 = text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Maximum tokens per LLM batch when analyzing code skeletons.
# Larger values = fewer LLM calls but higher cost per call.
MAX_CHUNK_TOKENS=2000
