# ============================================================
# Codebase Context Extraction Pipeline — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# LLM provider to use for distillation and summarization.
# Options: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI API key — required when LLM_PROVIDER is openai or anthropic (used for embeddings too).
# Not needed when LLM_PROVIDER=gemini.
OPENAI_API_KEY=sk-...

# Anthropic API key — only required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio API key — only required when LLM_PROVIDER=gemini.
# When set, Google's text-embedding-004 model is used for embeddings (768 dimensions).
# GOOGLE_API_KEY=AIza...

# PostgreSQL connection string.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/context_extractor

# Absolute or relative path to the repository you want to analyze.
TARGET_REPO_PATH=/path/to/your/repo

# Dimensions of the embedding vectors stored in the database.
# MUST match the VECTOR(n) column in your migration before running for the first time.
#   openai text-embedding-3-small : 1536 (default)
#   openai text-embedding-3-large : 3072
#   gemini text-embedding-004     : 768  <-- change to 768 when LLM_PROVIDER=gemini
EMBEDDING_DIMENSIONS=1536

# Maximum tokens per LLM batch when analyzing code skeletons.
# Larger values = fewer LLM calls but higher cost per call.
MAX_CHUNK_TOKENS=2000
